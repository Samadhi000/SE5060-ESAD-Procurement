@model IReadOnlyList<PurchaseOrder>
@{
    ViewData["Title"] = "Outstanding Deliveries";
}

<h2 style="color:#1F3864;">Outstanding Deliveries</h2>
<p class="text-muted">Orders that are placed or partly delivered and can still receive goods.</p>

@if (TempData["Message"] != null) { <div class="alert alert-success py-2">@TempData["Message"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger py-2">@TempData["Error"]</div> }

@if (Model.Count == 0)
{
    <div class="alert alert-info">No orders are currently awaiting delivery. Approve an order first (Approvals), then it appears here.</div>
}
else
{
    <table class="table table-hover bg-white shadow-sm align-middle">
        <thead style="background:#1F3864;color:#fff;">
            <tr><th>PO Reference</th><th>Site</th><th>Supplier</th><th>Status</th><th>Outstanding lines</th><th></th></tr>
        </thead>
        <tbody>
        @foreach (var o in Model)
        {
            var outstanding = o.Lines.Count(l => !l.IsFullyDelivered());
            <tr>
                <td class="fw-bold">@o.PoReference</td>
                <td>@o.Site?.SiteName</td>
                <td>@o.Supplier?.Name</td>
                <td><span class="badge bg-info text-dark">@o.Status</span></td>
                <td>@outstanding of @o.Lines.Count</td>
                <td class="text-end"><a asp-action="Record" asp-route-id="@o.PoReference" class="btn btn-sm btn-primary">Record Delivery</a></td>
            </tr>
        }
        </tbody>
    </table>
}
