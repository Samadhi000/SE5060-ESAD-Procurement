@model IReadOnlyList<PurchaseOrder>
@{
    ViewData["Title"] = "Pending Approvals";
    var policyFor = ViewBag.PolicyFor as Dictionary<string, ApprovalPolicyResult>
                    ?? new Dictionary<string, ApprovalPolicyResult>();
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h2 class="mb-1" style="color:#1F3864;">Pending Approvals</h2>
        <div class="text-muted">Review and resolve requisition approvals for active construction sites</div>
    </div>
    <form asp-action="ApplyPolicy" method="post">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-outline-primary">
            Apply Approval Policy
        </button>
    </form>
</div>

<div class="alert alert-info py-2">
    <strong>Active approval policy (Strategy):</strong> @ViewBag.PolicyName
    <span class="text-muted"> — "Apply Approval Policy" auto-approves every order the policy does not flag.</span>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success py-2">@TempData["Message"]</div>
}

@if (Model.Count == 0)
{
    <div class="card"><div class="card-body text-center text-success py-5">
        <div style="font-size:2rem;">&#10003;</div>
        <strong>You're all caught up</strong>
        <div class="text-muted">There are no requisitions waiting for approval.</div>
    </div></div>
}
else
{
    <table class="table table-hover align-middle bg-white shadow-sm">
        <thead style="background:#1F3864; color:#fff;">
            <tr>
                <th>PO Reference</th><th>Site</th><th>Supplier</th>
                <th class="text-end">Total Value</th><th>Submitted By</th>
                <th>Policy says</th><th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var o in Model)
        {
            var needs = policyFor.TryGetValue(o.PoReference, out var r) && r.RequiresApproval;
            <tr>
                <td><a asp-action="Details" asp-route-id="@o.PoReference" class="fw-bold text-decoration-none">@o.PoReference</a></td>
                <td>@o.Site?.SiteName</td>
                <td>@o.Supplier?.Name</td>
                <td class="text-end fw-bold">Rs.@o.TotalValue.ToString("N2")</td>
                <td>@o.CreatedBy?.Name</td>
                <td>
                    @if (needs)
                    {
                        <span class="badge bg-warning text-dark">Needs approval</span>
                    }
                    else
                    {
                        <span class="badge bg-success">Auto-approvable</span>
                    }
                </td>
                <td class="text-end">
                    <a asp-action="Details" asp-route-id="@o.PoReference" class="btn btn-sm btn-primary">Review</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
