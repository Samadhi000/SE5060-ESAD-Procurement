@model PurchaseOrder
@*  Module 2 — reproduces wireframe requisition-review.png  *@
@{
    Layout = "_ConsoleLayout";
    ViewData["Title"] = Model.PoReference;
    ViewData["Nav"] = "approvals";

    var policy = ViewBag.PolicyResult as ApprovalPolicyResult;
    var manager = ViewBag.CurrentManager as string ?? "Approver";
}

<div class="crumbs">
    <a asp-action="Index">Approvals</a>
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
    <span style="color:var(--brand);">@Model.PoReference</span>
</div>

<div class="page-head" style="align-items:center;">
    <div class="row-between gap-16">
        <h1 class="page-title" style="margin:0;">@Model.PoReference</h1>
        <span class="pill @StatusDisplay.PillClass(Model.Status)">@StatusDisplay.Label(Model.Status)</span>
    </div>
    <div style="border:1px solid var(--line);background:#fff;border-radius:10px;padding:11px 20px;">
        <span style="font-size:19px;font-weight:700;color:var(--navy);">LKR @Model.TotalValue.ToString("N2")</span>
    </div>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert--ok">@TempData["Message"]</div>
}

<div class="split">

    @* ---------------- LEFT: the requisition itself ---------------- *@
    <div>
        <div class="card card--info mb-24">
            <div class="card__body">
                <h2 class="mt-0" style="margin-bottom:14px;font-size:18px;font-weight:700;color:var(--navy);">Order Information</h2>
                <div class="specs specs--inline">
                    <div class="specs__row">
                        <div class="specs__k">Site Location</div>
                        <div class="specs__v">@Model.Site?.SiteName — @Model.Site?.Address</div>
                    </div>
                    <div class="specs__row">
                        <div class="specs__k">Contracted Supplier</div>
                        <div class="specs__v">@Model.Supplier?.Name</div>
                    </div>
                    <div class="specs__row">
                        <div class="specs__k">Dispatch Depot</div>
                        <div class="specs__v">@(Model.Depot?.Location ?? "Not specified")</div>
                    </div>
                    <div class="specs__row">
                        <div class="specs__k">Required Delivery By</div>
                        <div class="specs__v">@Model.RequiredByDate.ToString("dd MMM yyyy")</div>
                    </div>
                    <div class="specs__row">
                        <div class="specs__k">Submitted By</div>
                        <div class="specs__v">@(Model.CreatedBy?.Name ?? "—")</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="table-wrap">
            <h2 style="margin:0;padding:17px 20px 15px;font-size:17px;font-weight:700;color:var(--ink);">PO Requisition Line Items</h2>
            <table class="table">
                <thead>
                    <tr>
                        <th>Item Description</th>
                        <th class="num">Qty</th>
                        <th>Unit</th>
                        <th class="num">Unit Price</th>
                        <th class="num">Line Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in Model.Lines)
                    {
                        <tr>
                            <td>@line.Item.Description</td>
                            <td class="num">@line.QuantityOrdered</td>
                            <td class="muted">@line.Item.UnitOfMeasure</td>
                            <td class="num">LKR @line.UnitPrice.ToString("N2")</td>
                            <td class="num strong">LKR @line.LineTotal.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="4">SUBTOTAL ORDER VALUE</td>
                        <td class="num">LKR @Model.TotalValue.ToString("N2")</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    @* ---------------- RIGHT: decision workspace ---------------- *@
    <div class="card">
        <div class="card__body">
            <h2 class="mt-0" style="margin-bottom:18px;font-size:18px;font-weight:700;color:var(--navy);">Decision Workspace</h2>

            <div class="section-label" style="margin-top:0;">Audit history timeline</div>
            <div class="timeline mb-24">
                <div class="timeline__item">
                    <div class="timeline__t">Created by @(Model.CreatedBy?.Name ?? "Site Manager")</div>
                    <div class="timeline__m">@Model.DateCreated.ToString("dd MMM yyyy · HH:mm")</div>
                </div>
                <div class="timeline__item">
                    <div class="timeline__t">Submitted for approval</div>
                    <div class="timeline__m">@Model.DateCreated.ToString("dd MMM yyyy · HH:mm")</div>
                </div>

                @foreach (var a in Model.Approvals.OrderBy(x => x.DecisionDate))
                {
                    var tone = a.Decision == ApprovalDecisionType.Approved ? "timeline__item--green" : "timeline__item--amber";
                    <div class="timeline__item @tone">
                        <div class="timeline__t">@a.Decision by @a.ManagerName</div>
                        <div class="timeline__m">@a.DecisionDate.ToString("dd MMM yyyy · HH:mm")</div>
                        @if (!string.IsNullOrWhiteSpace(a.Comment))
                        {
                            <div class="timeline__note">“@a.Comment”</div>
                        }
                    </div>
                }

                @if (Model.Status == PurchaseOrderStatus.WaitingForApproval)
                {
                    <div class="timeline__item timeline__item--amber">
                        <div class="timeline__t timeline__t--amber">Awaiting @manager review</div>
                        <div class="timeline__m">Assigned to your queue</div>
                    </div>
                }
            </div>

            @if (policy is not null)
            {
                <div class="alert @(policy.RequiresApproval ? "alert--warn" : "alert--ok")">
                    <strong>Policy:</strong>&nbsp;@policy.Reason
                </div>
            }

            @if (Model.Status is PurchaseOrderStatus.WaitingForApproval or PurchaseOrderStatus.Referred)
            {
                <div class="field">
                    <label class="label" for="comment">Audit Trail Comments</label>
                    <textarea class="textarea" id="comment" name="comment" form="approve-form"
                              placeholder="Add a note for the audit trail…"></textarea>
                </div>

                <form id="approve-form" asp-action="Approve" method="post" class="mb-8">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.PoReference" />
                    <button type="submit" class="btn btn--success btn--block">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.5 2.5L16 9.5"/></svg>
                        Approve Requisition
                    </button>
                </form>

                <form asp-action="Decline" method="post" class="mb-8">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.PoReference" />
                    <input type="hidden" name="comment" value="Declined by approver" />
                    <button type="submit" class="btn btn--danger btn--block">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M15 9l-6 6M9 9l6 6"/></svg>
                        Decline Order
                    </button>
                </form>

                <form asp-action="Refer" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.PoReference" />
                    <input type="hidden" name="comment" value="Referred for further review" />
                    <button type="submit" class="btn btn--slate btn--block">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 17V9a4 4 0 0 1 4-4h11"/><path d="M15 2l4 3-4 3"/></svg>
                        Refer to…
                    </button>
                </form>
            }
            else
            {
                <div class="alert alert--info" style="margin:0;">
                    This requisition is <strong>@StatusDisplay.Label(Model.Status)</strong> — no further decision is required.
                </div>
            }
        </div>
    </div>
</div>
