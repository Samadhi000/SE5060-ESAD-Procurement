@{
    ViewData["Title"] = "Requisition Submitted";
    var reference = ViewBag.Reference as string;
}

<div class="card shadow-sm mx-auto" style="max-width:480px;">
    <div class="card-body text-center py-5">
        <div class="text-success" style="font-size:3rem;">&#10003;</div>
        <h3 class="mt-2">Requisition sent for approval</h3>
        <p class="text-muted">Your purchase requisition has been submitted to the designated approvers.</p>

        <div class="bg-light rounded p-3 my-3">
            <div class="text-muted small">REQUISITION REFERENCE</div>
            <div class="fs-4 fw-bold" style="color:#1F3864;">@reference</div>
            <span class="badge bg-warning text-dark">Waiting for Approval</span>
        </div>

        <a asp-controller="Enquiry" asp-action="Index" class="btn btn-primary">View My Orders</a>
        <a asp-controller="Order" asp-action="Create" class="btn btn-outline-secondary">New Order</a>
    </div>
</div>
