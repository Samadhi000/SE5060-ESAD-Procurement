@{
    ViewData["Title"] = "New Purchase Order";
    var sites = ViewBag.Sites as IReadOnlyList<Site> ?? new List<Site>();
    var suppliers = ViewBag.Suppliers as IReadOnlyList<Supplier> ?? new List<Supplier>();
}

<h2 style="color:#1F3864;">New Purchase Order <small class="text-muted fs-6">Step 1 of 3</small></h2>
<p class="text-muted">Choose the destination site and an approved supplier, then add catalogue items.</p>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger py-2">@TempData["Error"]</div>
}

<div class="card shadow-sm" style="max-width:560px;">
    <div class="card-body">
        <form asp-action="AddItems" method="get">
            <div class="mb-3">
                <label class="form-label fw-semibold">Delivery Site *</label>
                <select name="siteId" class="form-select" required>
                    <option value="">Select site…</option>
                    @foreach (var s in sites)
                    {
                        <option value="@s.Id">@s.SiteName</option>
                    }
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">Approved Supplier *</label>
                <select name="supplierId" class="form-select" required>
                    <option value="">Approved suppliers only…</option>
                    @foreach (var s in suppliers)
                    {
                        <option value="@s.Id">@s.Name</option>
                    }
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">Required By *</label>
                <input type="date" name="requiredBy" class="form-control"
                       value="@DateTime.Now.AddDays(14).ToString("yyyy-MM-dd")" required />
            </div>
            <button type="submit" class="btn btn-primary">Next &rarr;</button>
        </form>
    </div>
</div>
