@*  Module 1, step 1 — reproduces wireframe PurchaseOrder-1.png  *@
@{
    Layout = "_MobileLayout";
    ViewData["Title"] = "New Purchase Order";
    ViewData["AppTitle"] = "New Purchase Order";
    ViewData["Step"] = "Step 1 of 3";
    ViewData["Back"] = Url.Action("Index", "Home");

    var sites = ViewBag.Sites as IReadOnlyList<Site> ?? new List<Site>();
    var suppliers = ViewBag.Suppliers as IReadOnlyList<Supplier> ?? new List<Supplier>();
    var multiDepot = suppliers.Where(s => s.Depots.Count > 0).ToList();
}

<h2 class="mt-0" style="margin-bottom:6px;font-size:20px;font-weight:700;color:var(--ink);">Requisition Details</h2>
<p class="muted" style="margin:0 0 20px;font-size:14px;line-height:1.5;">
    Please specify the destination job site and an approved supplier to begin adding catalogue items.
</p>

@if (TempData["Error"] != null)
{
    <div class="alert alert--err">@TempData["Error"]</div>
}

<form id="po-step1" method="get" asp-action="AddItems">
    <div class="field">
        <label class="label" for="siteId">Delivery Site <span class="req">*</span></label>
        <div class="input-icon">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s7-5.7 7-11a7 7 0 1 0-14 0c0 5.3 7 11 7 11z"/><circle cx="12" cy="10" r="2.6"/></svg>
            <select class="select" id="siteId" name="siteId" required>
                <option value="">Select site</option>
                @foreach (var s in sites)
                {
                    <option value="@s.Id">@s.SiteName</option>
                }
            </select>
        </div>
    </div>

    <div class="field">
        <label class="label" for="supplierId">Approved Supplier <span class="req">*</span></label>
        <div class="input-icon">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8.5 7V5.5A1.5 1.5 0 0 1 10 4h4a1.5 1.5 0 0 1 1.5 1.5V7"/></svg>
            <select class="select" id="supplierId" name="supplierId" required>
                <option value="">Approved suppliers only</option>
                @foreach (var s in suppliers)
                {
                    <option value="@s.Id">@s.Name</option>
                }
            </select>
        </div>
    </div>

    <div class="field">
        <label class="label" for="depotId">Depot (Optional)</label>
        <div class="input-icon">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10l9-7 9 7v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1z"/><path d="M9 21v-7h6v7"/></svg>
            <select class="select" id="depotId" name="depotId">
                <option value="">Select depot</option>
                @foreach (var s in multiDepot)
                {
                    <optgroup label="@s.Name">
                        @foreach (var d in s.Depots)
                        {
                            <option value="@d.Id">@d.Location</option>
                        }
                    </optgroup>
                }
            </select>
        </div>
        <div class="hint">Only for multi-depot suppliers</div>
    </div>

    <div class="field">
        <label class="label" for="requiredBy">Required By <span class="req">*</span></label>
        <div class="input-icon">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18"/><path d="M8 3v4M16 3v4"/></svg>
            <input class="input" type="date" id="requiredBy" name="requiredBy"
                   value="@DateTime.Now.AddDays(14).ToString("yyyy-MM-dd")" required />
        </div>
    </div>
</form>

@section Action {
    <div class="actionbar actionbar--split">
        <a asp-controller="Enquiry" asp-action="Index" class="btn--link">Save as Draft</a>
        <button type="submit" form="po-step1" class="btn btn--primary">
            Next
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </button>
    </div>
}
