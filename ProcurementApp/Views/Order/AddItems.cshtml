@model IReadOnlyList<CatalogueItem>
@{
    ViewData["Title"] = "Add Items";
    var site = ViewBag.Site as Site;
    var supplier = ViewBag.Supplier as Supplier;
    var requiredBy = (DateTime)ViewBag.RequiredBy;
}

<h2 style="color:#1F3864;">Add Items <small class="text-muted fs-6">Step 2 of 3</small></h2>
<p class="text-muted">
    Site: <strong>@site?.SiteName</strong> &nbsp;|&nbsp;
    Supplier: <strong>@supplier?.Name</strong> &nbsp;|&nbsp;
    Required by: <strong>@requiredBy.ToString("dd MMM yyyy")</strong>
</p>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger py-2">@TempData["Error"]</div>
}

<form asp-action="Submit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="siteId" value="@site?.Id" />
    <input type="hidden" name="supplierId" value="@supplier?.Id" />
    <input type="hidden" name="requiredBy" value="@requiredBy.ToString("yyyy-MM-dd")" />

    <table class="table bg-white shadow-sm align-middle">
        <thead style="background:#1F3864;color:#fff;">
            <tr><th>Catalogue Item</th><th>Unit</th><th class="text-end">Agreed Price</th><th style="width:140px;">Quantity</th></tr>
        </thead>
        <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>
                    @c.Item.Description
                    <input type="hidden" name="itemCode" value="@c.Item.ItemCode" />
                </td>
                <td>@c.Item.UnitOfMeasure</td>
                <td class="text-end">Rs.@c.AgreedPrice.ToString("N2")</td>
                <td><input type="number" name="quantity" value="0" min="0" class="form-control form-control-sm" /></td>
            </tr>
        }
        </tbody>
    </table>

    @if (Model.Count == 0)
    {
        <div class="alert alert-warning">This supplier has no priced catalogue items.</div>
    }

    <button type="submit" class="btn btn-success">Submit for Approval</button>
    <a asp-action="Create" class="btn btn-link">Cancel</a>
    <p class="text-muted small mt-2">Enter a quantity for the items you need; leave others at 0.</p>
</form>
