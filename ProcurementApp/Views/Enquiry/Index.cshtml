@model IReadOnlyList<PurchaseOrder>
@{
    ViewData["Title"] = "My Orders";
    var query = ViewBag.Query as string;
    var selected = ViewBag.Status as PurchaseOrderStatus?;
}

<h2 style="color:#1F3864;">My Orders</h2>
<p class="text-muted">Search and view the status, approval history and delivery progress of any order.</p>

<form asp-action="Index" method="get" class="row g-2 mb-3" style="max-width:720px;">
    <div class="col-sm-6">
        <input type="text" name="q" value="@query" class="form-control" placeholder="Search PO reference, site or supplier…" />
    </div>
    <div class="col-sm-4">
        <select name="status" class="form-select">
            <option value="">All statuses</option>
            @foreach (var s in Enum.GetValues<PurchaseOrderStatus>())
            {
                if (selected == s)
                {
                    <option value="@s" selected>@s</option>
                }
                else
                {
                    <option value="@s">@s</option>
                }
            }
        </select>
    </div>
    <div class="col-sm-2"><button type="submit" class="btn btn-primary w-100">Search</button></div>
</form>

@if (Model.Count == 0)
{
    <div class="alert alert-info">No purchase orders match your search.</div>
}
else
{
    <table class="table table-hover bg-white shadow-sm align-middle">
        <thead style="background:#1F3864;color:#fff;">
            <tr><th>PO Reference</th><th>Site</th><th>Supplier</th><th class="text-end">Value</th><th>Status</th><th>Created</th><th></th></tr>
        </thead>
        <tbody>
        @foreach (var o in Model)
        {
            <tr>
                <td class="fw-bold">@o.PoReference</td>
                <td>@o.Site?.SiteName</td>
                <td>@o.Supplier?.Name</td>
                <td class="text-end">Rs.@o.TotalValue.ToString("N2")</td>
                <td><span class="badge bg-secondary">@o.Status</span></td>
                <td>@o.DateCreated.ToString("dd MMM yyyy")</td>
                <td class="text-end"><a asp-action="Details" asp-route-id="@o.PoReference" class="btn btn-sm btn-outline-primary">View</a></td>
            </tr>
        }
        </tbody>
    </table>
}
