@model IReadOnlyList<StatusSummaryRow>
@*  Module 4 — management reporting, in the portal shell  *@
@{
    Layout = "_ConsoleLayout";
    ViewData["Title"] = "Reports";
    ViewData["Nav"] = "reports";

    var total = (decimal)ViewBag.Total;
    var orders = Model.Sum(r => r.Count);
    var maxCount = Model.Count == 0 ? 1 : Model.Max(r => r.Count);
}

<div class="page-head">
    <div>
        <h1 class="page-title">Procurement Reports</h1>
        <p class="page-sub">Consolidated view of all purchase orders by status, for Management</p>
    </div>
</div>

<div class="kpis">
    <div class="kpi">
        <div class="kpi__k">Total Orders</div>
        <div class="kpi__v">@orders</div>
    </div>
    <div class="kpi">
        <div class="kpi__k">Total Value</div>
        <div class="kpi__v">LKR @total.ToString("N2")</div>
    </div>
    <div class="kpi">
        <div class="kpi__k">Statuses in Use</div>
        <div class="kpi__v">@Model.Count</div>
    </div>
</div>

<div class="table-wrap">
    <table class="table">
        <thead>
            <tr>
                <th>Status</th>
                <th style="width:40%;">Distribution</th>
                <th class="num">Order Count</th>
                <th class="num">Total Value</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.OrderByDescending(r => r.Count))
            {
                var pct = (int)Math.Round(r.Count * 100.0 / maxCount);
                <tr>
                    <td><span class="pill @StatusDisplay.PillClass(r.Status)">@StatusDisplay.Label(r.Status)</span></td>
                    <td>
                        <div class="progress"><div class="progress__bar" style="width:@pct%"></div></div>
                    </td>
                    <td class="num strong">@r.Count</td>
                    <td class="num">LKR @r.Value.ToString("N2")</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="2">TOTAL</td>
                <td class="num">@orders</td>
                <td class="num">LKR @total.ToString("N2")</td>
            </tr>
        </tfoot>
    </table>
</div>
