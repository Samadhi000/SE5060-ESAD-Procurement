@*
    DESKTOP SHELL — the Approving Manager's web portal.
    Reproduces the console chrome from the ESAD-02 wireframes (pending-approvals.png,
    requisition-review.png, order-enquiry-desktop.png): navy sidebar with branded mark and
    nav list, navy top bar with search / environment pill / alerts / avatar, light content area.

    A view drives it through ViewData:
      Nav — highlights a sidebar item: dashboard | approvals | orders | reports | alerts
*@
@{
    var nav = ViewData["Nav"] as string;
    string On(string key) => nav == key ? "is-active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — SitePro Procurement</title>
    <link rel="stylesheet" href="~/css/sitepro.css" asp-append-version="true" />
</head>
<body class="on-console">
    <div class="console">

        @* ---- sidebar ---- *@
        <aside class="sidebar">
            <div class="brand">
                <span class="brand__mark">
                    <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M2 18h20"/><path d="M4 18a8 8 0 0 1 16 0"/><path d="M12 4v6"/><path d="M8.5 10.8A8 8 0 0 1 12 10c1.3 0 2.5.3 3.5.8"/></svg>
                </span>
                <span>
                    <span class="brand__name">SitePro</span><br />
                    <span class="brand__sub">Procurement</span>
                </span>
            </div>

            <nav class="navlist">
                <a href="@Url.Action("Index", "Home")" class="@On("dashboard")">
                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
                    Dashboard
                </a>
                <a href="@Url.Action("Index", "Approval")" class="@On("approvals")">
                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"/><path d="M6 18v-3.5a6 6 0 0 1 12 0V18"/><path d="M12 8.5V3"/><path d="M9 5h6"/></svg>
                    Approvals
                </a>
                <a href="@Url.Action("Portal", "Enquiry")" class="@On("orders")">
                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16l-1.5 11.5a2 2 0 0 1-2 1.5H7.5a2 2 0 0 1-2-1.5z"/><path d="M8.5 7V5.5a3.5 3.5 0 0 1 7 0V7"/></svg>
                    Orders
                </a>
                <a href="@Url.Action("Reports", "Enquiry")" class="@On("reports")">
                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 13v4"/><path d="M12 9v8"/><path d="M16 11v6"/></svg>
                    Reports
                </a>
                <a href="@Url.Action("Index", "Notifications")" class="@On("alerts")">
                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 1 0-12 0c0 6-2.5 7-2.5 7h17S18 14 18 8z"/><path d="M10.3 19a2 2 0 0 0 3.4 0"/></svg>
                    Notifications
                </a>
            </nav>

            <div class="sidebar__foot">
                <span class="avatar">SC</span>
                <span>
                    <span class="n">Sarah Chen</span><br />
                    <span class="r">Commercial Manager</span>
                </span>
            </div>
        </aside>

        @* ---- top bar + content ---- *@
        <div class="console__col">
            <div class="topbar">
                <form class="searchbox" method="get" action="@Url.Action("Portal", "Enquiry")" role="search">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
                    <input type="text" name="q" placeholder="Search POs, suppliers or sites…" aria-label="Search" />
                </form>
                <span class="topbar__spacer"></span>
                <span class="env-pill">PRODUCTION</span>
                <a href="@Url.Action("Index", "Notifications")" class="icon-btn" aria-label="Notifications">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 1 0-12 0c0 6-2.5 7-2.5 7h17S18 14 18 8z"/><path d="M10.3 19a2 2 0 0 0 3.4 0"/></svg>
                </a>
                <span class="avatar avatar--sm">SC</span>
            </div>

            <main class="main">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/js/sitepro.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
