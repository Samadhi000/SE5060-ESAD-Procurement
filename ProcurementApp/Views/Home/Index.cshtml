@*  Dashboard / launcher — the design deploys a phone app AND a web portal, so both start here  *@
@{
    Layout = "_ConsoleLayout";
    ViewData["Title"] = "Dashboard";
    ViewData["Nav"] = "dashboard";

    var pending = (int)ViewBag.PendingCount;
    var deliverable = (int)ViewBag.DeliverableCount;
    var orders = (int)ViewBag.OrderCount;
    var totalValue = (decimal)ViewBag.TotalValue;
}

<div class="page-head">
    <div>
        <h1 class="page-title">SitePro Procurement</h1>
        <p class="page-sub">
            Site procurement, approvals and goods receipt for construction projects.
        </p>
    </div>
</div>

<div class="kpis">
    <div class="kpi">
        <div class="kpi__k">In Approval Queue</div>
        <div class="kpi__v">@pending</div>
    </div>
    <div class="kpi">
        <div class="kpi__k">Awaiting Delivery</div>
        <div class="kpi__v">@deliverable</div>
    </div>
    <div class="kpi">
        <div class="kpi__k">Total Orders</div>
        <div class="kpi__v">@orders</div>
    </div>
    <div class="kpi">
        <div class="kpi__k">Total Value</div>
        <div class="kpi__v">LKR @totalValue.ToString("N2")</div>
    </div>
</div>

<div class="split">

    @* ---------------- the phone app ---------------- *@
    <div class="card">
        <div class="card__body">
            <div class="row-between gap-12 mb-16">
                <div>
                    <h2 class="mt-0" style="margin-bottom:4px;font-size:19px;font-weight:700;color:var(--navy);">
                        Site Operations
                    </h2>
                    <p class="muted mb-0" style="font-size:14px;">
                        Raise requisitions, receive goods and check order status from the job site.
                    </p>
                </div>
                <span class="pill pill--blue">Phone</span>
            </div>

            <div class="stack gap-10">
                <a class="lrow" asp-controller="Order" asp-action="Create">
                    <div>
                        <div class="lrow__name">Create &amp; Submit Purchase Order</div>
                        <div class="lrow__sub">Raise a materials requisition and send it for approval</div>
                    </div>
                    <span class="muted">&rarr;</span>
                </a>
                <a class="lrow" asp-controller="Delivery" asp-action="Index">
                    <div>
                        <div class="lrow__name">Log Delivery <span class="muted">(@deliverable open)</span></div>
                        <div class="lrow__sub">Record goods received against placed orders</div>
                    </div>
                    <span class="muted">&rarr;</span>
                </a>
                <a class="lrow" asp-controller="Enquiry" asp-action="Index">
                    <div>
                        <div class="lrow__name">My Orders &amp; history</div>
                        <div class="lrow__sub">Track approval and delivery progress</div>
                    </div>
                    <span class="muted">&rarr;</span>
                </a>
            </div>
        </div>
    </div>

    @* ---------------- the web portal ---------------- *@
    <div class="card">
        <div class="card__body">
            <div class="row-between gap-12 mb-16">
                <div>
                    <h2 class="mt-0" style="margin-bottom:4px;font-size:19px;font-weight:700;color:var(--navy);">
                        Back Office
                    </h2>
                    <p class="muted mb-0" style="font-size:14px;">Review and resolve requisitions in the office.</p>
                </div>
                <span class="pill pill--grey">Desktop</span>
            </div>

            <div class="stack gap-10">
                <a class="lrow" asp-controller="Approval" asp-action="Index">
                    <div>
                        <div class="lrow__name">Pending Approvals <span class="muted">(@pending)</span></div>
                        <div class="lrow__sub">Review requisitions awaiting a decision</div>
                    </div>
                    <span class="muted">&rarr;</span>
                </a>
                <a class="lrow" asp-controller="Enquiry" asp-action="Portal">
                    <div>
                        <div class="lrow__name">Order Enquiry workspace</div>
                        <div class="lrow__sub">Search and drill into any purchase order</div>
                    </div>
                    <span class="muted">&rarr;</span>
                </a>
                <a class="lrow" asp-controller="Enquiry" asp-action="Reports">
                    <div>
                        <div class="lrow__name">Management Reports</div>
                        <div class="lrow__sub">Spend and status summary across all sites</div>
                    </div>
                    <span class="muted">&rarr;</span>
                </a>
            </div>

            <div class="alert alert--info mt-16 mb-0">
                <strong>Approval policy in force:</strong>&nbsp;@ViewBag.PolicyName
            </div>
        </div>
    </div>
</div>
